    "antd": "^5.22.0",
    "react-virtuoso": "^4.10.0",
    "lucide-react": "^0.460.0",
    "electron-store": "^8.2.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
